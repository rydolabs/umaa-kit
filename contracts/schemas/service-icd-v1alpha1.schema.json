{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rydolabs/umaa-kit/blob/main/contracts/schemas/service-icd-v1alpha1.schema.json",
  "title": "K-UMAA human-readable service ICD view (design draft)",
  "description": "Human-readable projection of official ICD/IDL; not an authoritative document, native QoS source or permission to generate a wire-ready Service.",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x-[a-z][a-z0-9.-]*$": {}
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec",
    "provenance",
    "verification"
  ],
  "properties": {
    "apiVersion": {
      "const": "kumaa.dev/v1alpha1"
    },
    "kind": {
      "const": "ServiceICD"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-[a-z][a-z0-9.-]*$": {}
      },
      "required": [
        "name",
        "namespace",
        "domain",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*){2,}$"
        },
        "domain": {
          "enum": [
            "EO",
            "MO",
            "MM",
            "SA",
            "SEM",
            "SO",
            "CO",
            "custom"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9._/-]*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-[a-z][a-z0-9.-]*$": {}
      },
      "required": [
        "purpose",
        "operations",
        "topics",
        "flows",
        "documentation"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "operations": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "patternProperties": {
              "^x-[a-z][a-z0-9.-]*$": {}
            },
            "required": [
              "actor",
              "transport",
              "description",
              "clause"
            ],
            "properties": {
              "actor": {
                "enum": [
                  "provider",
                  "consumer"
                ]
              },
              "transport": {
                "enum": [
                  "subscribe",
                  "publish",
                  "dds-dispose",
                  "dds-native",
                  "command",
                  "local"
                ]
              },
              "topicRef": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "clause": {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]+)*$"
              },
              "table": {
                "type": "integer",
                "minimum": 1
              },
              "produces": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                }
              },
              "consumes": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                }
              }
            }
          }
        },
        "topics": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "patternProperties": {
              "^x-[a-z][a-z0-9.-]*$": {}
            },
            "required": [
              "catalogIdentity",
              "idlType",
              "idlPath",
              "ddsTopicName",
              "writer",
              "reader",
              "role",
              "keyFields",
              "qosProfileRef"
            ],
            "properties": {
              "catalogIdentity": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*){2,}$"
              },
              "idlType": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*){2,}$"
              },
              "idlPath": {
                "type": "string",
                "minLength": 1
              },
              "ddsTopicName": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "writer": {
                "enum": [
                  "provider",
                  "consumer"
                ]
              },
              "reader": {
                "enum": [
                  "provider",
                  "consumer"
                ]
              },
              "role": {
                "enum": [
                  "report",
                  "status",
                  "command",
                  "ack",
                  "execution_status",
                  "metadata",
                  "element",
                  "general",
                  "specialization"
                ]
              },
              "keyFields": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ]
              },
              "qosProfileRef": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "inherits": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "attributes": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "patternProperties": {
                    "^x-[a-z][a-z0-9.-]*$": {}
                  },
                  "required": [
                    "typeRef",
                    "optional",
                    "description"
                  ],
                  "properties": {
                    "typeRef": {
                      "type": "string",
                      "minLength": 1
                    },
                    "optional": {
                      "type": "boolean"
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "inheritedFrom": {
                      "type": "string",
                      "minLength": 1
                    },
                    "key": {
                      "type": "boolean"
                    },
                    "sourceClause": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "sourceClause": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "flows": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "patternProperties": {
              "^x-[a-z][a-z0-9.-]*$": {}
            },
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "request-reply-without-query-data",
                  "command-response",
                  "report-status",
                  "large-set",
                  "large-list",
                  "generalization-specialization",
                  "custom-extension"
                ]
              },
              "queryOperation": {
                "type": "string",
                "minLength": 1
              },
              "reportOperation": {
                "type": "string",
                "minLength": 1
              },
              "topicRef": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "queryUsesDdsTopic": {
                "type": "boolean"
              },
              "commandTopicRef": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "ackTopicRef": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "statusTopicRef": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "executionStatusTopicRef": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "cancelOperation": {
                "type": "string",
                "minLength": 1
              },
              "updateOperation": {
                "type": "string",
                "minLength": 1
              },
              "metadataTopicRef": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "elementTopicRef": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "generalTopicRef": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "specializationTopicRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "synchronization": {
                "type": "object",
                "additionalProperties": false,
                "patternProperties": {
                  "^x-[a-z][a-z0-9.-]*$": {}
                },
                "required": [],
                "properties": {
                  "idField": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  },
                  "timestampField": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  },
                  "ruleRef": {
                    "type": "string",
                    "minLength": 1
                  },
                  "disposal": {
                    "enum": [
                      "both-topics",
                      "collection-metadata",
                      "per-instance"
                    ]
                  },
                  "requiredCapabilities": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "reliable",
                        "instance-lifecycle",
                        "coherent-group",
                        "ordered-access",
                        "liveliness"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "documentation": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^x-[a-z][a-z0-9.-]*$": {}
          },
          "required": [
            "serviceSection"
          ],
          "properties": {
            "serviceSection": {
              "type": "string",
              "minLength": 1
            },
            "operationsTable": {
              "type": "integer",
              "minimum": 1
            },
            "messageTables": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "patternProperties": {
                  "^x-[a-z][a-z0-9.-]*$": {}
                },
                "required": [
                  "number",
                  "topicRef"
                ],
                "properties": {
                  "number": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "topicRef": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                  }
                }
              }
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "blocks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "patternProperties": {
                  "^x-[a-z][a-z0-9.-]*$": {}
                },
                "required": [
                  "clause",
                  "kind"
                ],
                "properties": {
                  "clause": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "enum": [
                      "paragraph",
                      "table",
                      "figure",
                      "rule",
                      "note",
                      "example"
                    ]
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "body": {
                    "type": "string",
                    "minLength": 1
                  },
                  "columns": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "rows": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "assetRef": {
                    "type": "string",
                    "minLength": 1
                  },
                  "provenanceRef": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-[a-z][a-z0-9.-]*$": {}
      },
      "required": [
        "icd",
        "idl",
        "catalog"
      ],
      "properties": {
        "icd": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^x-[a-z][a-z0-9.-]*$": {}
          },
          "required": [
            "document",
            "version",
            "clauses",
            "officialSha256"
          ],
          "properties": {
            "document": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "const": "6.0"
            },
            "clauses": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "officialSha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "transcription": {
              "type": "object",
              "additionalProperties": false,
              "patternProperties": {
                "^x-[a-z][a-z0-9.-]*$": {}
              },
              "required": [
                "repository",
                "revision"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                }
              }
            }
          }
        },
        "idl": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^x-[a-z][a-z0-9.-]*$": {}
          },
          "required": [
            "originalRootSha256"
          ],
          "properties": {
            "originalRootSha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "catalog": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^x-[a-z][a-z0-9.-]*$": {}
          },
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-[a-z][a-z0-9.-]*$": {}
      },
      "required": [
        "stage",
        "officialIdlTypes",
        "keysAndQos",
        "nativeDdsWire"
      ],
      "properties": {
        "stage": {
          "enum": [
            "draft",
            "mapping-reviewed",
            "type-reviewed",
            "wire-tested"
          ]
        },
        "officialIdlTypes": {
          "type": "boolean"
        },
        "keysAndQos": {
          "type": "boolean"
        },
        "nativeDdsWire": {
          "type": "boolean"
        }
      }
    },
    "imports": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": {
          "^x-[a-z][a-z0-9.-]*$": {}
        },
        "required": [
          "path",
          "sha256",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)[a-zA-Z0-9_./-]+\\.ya?ml$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "enum": [
              "ProtocolProfile",
              "DocumentationLibrary"
            ]
          }
        }
      }
    }
  }
}
