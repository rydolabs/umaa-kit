{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/umaa/verifier/studio-result-v1.schema.json",
  "title": "UMAA verifier development result (not conformance)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "exportedAtUtc", "sourceType", "sourceEvidenceDigestSha256", "suiteId", "result", "conformanceClaim", "normativeRequirementRefs", "contractReviewStatus", "explanation", "cases"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "kind": {"const": "umaa-verifier-development-result"},
    "exportedAtUtc": {"type": "string", "format": "date-time"},
    "sourceType": {"enum": ["run", "suite"]},
    "sourceEvidenceDigestSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "suiteId": {"type": ["string", "null"]},
    "result": {"enum": ["PASS", "FAIL", "BLOCKED", "ERROR"]},
    "conformanceClaim": {"const": false},
    "normativeRequirementRefs": {"const": []},
    "contractReviewStatus": {"const": "development-unreviewed"},
    "explanation": {"type": "string"},
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["caseId", "runId", "profileId", "contractId", "transport", "result", "verdictDigestSha256", "conformanceClaim", "normativeRequirementRefs", "ddsNetworkApprovalDeclared", "startedAtUtc", "durationMs", "inputDigests", "artifactDigests"],
        "properties": {
          "caseId": {"type": "string"},
          "runId": {"type": "string"},
          "profileId": {"type": "string"},
          "contractId": {"type": "string"},
          "transport": {"enum": ["stdio-fixture", "cyclonedds"]},
          "result": {"enum": ["PASS", "FAIL", "BLOCKED", "ERROR"]},
          "verdictDigestSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "conformanceClaim": {"const": false},
          "normativeRequirementRefs": {"const": []},
          "ddsNetworkApprovalDeclared": {"type": "boolean"},
          "startedAtUtc": {"type": ["string", "null"]},
          "durationMs": {"type": ["integer", "null"], "minimum": 0},
          "inputDigests": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
          "artifactDigests": {"type": "object", "additionalProperties": {"type": "string"}}
        }
      }
    }
  }
}
